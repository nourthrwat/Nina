---
// Image (553×660) beside a heading, copy and "Reserveer nu" (Figma "Frame 40/41/42").
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from './Button.astro';
import HandLarge from '../assets/icons/hand-large.svg';

interface Props {
  title: string;
  text: string;
  image: ImageMetadata;
  alt: string;
  reverse?: boolean;
  ornament?: boolean;
  /** Figma darkens these photos by 20–30%. */
  dim?: number;
}
const { title, text, image, alt, reverse = false, ornament = false, dim = 0.3 } = Astro.props;
---

<section class:list={['media-text', { 'media-text--reverse': reverse }]}>
  <div class="media-text__media" data-reveal="clip" style={`--dim:${dim}`}>
    <Image src={image} alt={alt} widths={[560, 1106]} sizes="(max-width: 767px) 100vw, 553px" loading="lazy" />
  </div>
  <div class="media-text__body" data-reveal>
    {ornament && <HandLarge class="media-text__ornament" width={26} height={61} aria-hidden="true" />}
    <h2 class="h3">{title}</h2>
    <p>{text}</p>
    <Button href="/reservation/">Reserveer nu</Button>
  </div>
</section>

<style>
  .media-text {
    display: grid;
    grid-template-columns: minmax(0, 553fr) minmax(0, 470fr);
    align-items: center;
    column-gap: clamp(40px, 9.65vw, 139px);
    max-width: calc(var(--w-main) + var(--gutter) * 2);
    margin-inline: auto;
    padding: 60px var(--gutter);
  }
  .media-text--reverse { grid-template-columns: minmax(0, 470fr) minmax(0, 553fr); }
  .media-text--reverse .media-text__media { order: 2; }

  .media-text__media {
    position: relative;
    aspect-ratio: 553 / 660;
    overflow: hidden;
  }
  .media-text__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, var(--dim));
  }
  .media-text__media img { width: 100%; height: 100%; object-fit: cover; }

  .media-text__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .media-text__body :global(.media-text__ornament) { margin-bottom: 48px; }
  .media-text__body h2 { margin-bottom: 40px; }
  .media-text__body p { margin-bottom: 48px; letter-spacing: 0; }

  @media (max-width: 767px) {
    .media-text,
    .media-text--reverse { grid-template-columns: 1fr; row-gap: 40px; padding-block: 40px; }
    .media-text--reverse .media-text__media { order: 0; }
    .media-text__media { aspect-ratio: 4 / 4.4; }
    .media-text__body h2 { margin-bottom: 24px; }
    .media-text__body p { margin-bottom: 32px; }
  }
</style>
