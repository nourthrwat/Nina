---
import { url } from '../lib/url';
import Logo from '../assets/icons/logo.svg';
import Button from './Button.astro';
import { allPages, contact, nav } from '../data/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => url(href) === path;
---

<header class="header">
  <div class="header__bar">
    <div class="header__left">
      <button
        class="header__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-menu"
        data-menu-toggle
      >
        <span class="visually-hidden">Menu openen</span>
        <span class="header__burger" aria-hidden="true"><span></span><span></span></span>
      </button>
      <span class="header__divider" aria-hidden="true"></span>
      <nav class="header__nav" aria-label="Hoofdnavigatie">
        <ul role="list">
          {nav.map((item) => (
            <li>
              <a href={url(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <a href={url('/')} class="header__logo" aria-label="Nim – naar de homepage">
      <Logo width={107} height={64} aria-hidden="true" />
    </a>

    <div class="header__right">
      <p class="header__rating"><span aria-hidden="true">⭐️</span> 4.8/5 - Gebaseerd op 50+ Google reviews</p>
      <Button href={url('/reservation/')} class="header__cta">Reserveer nu</Button>
    </div>
  </div>

  <div class="menu" id="site-menu" data-menu hidden>
    <nav class="menu__inner container" aria-label="Volledig menu">
      <ul role="list" class="menu__list">
        {allPages.map((item, i) => (
          <li style={`--i:${i}`}>
            <a href={url(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
      <div class="menu__meta">
        <p>{contact.street}<br />{contact.city}</p>
        <p><a href={`mailto:${contact.email}`}>{contact.email}</a><br /><a href={`tel:${contact.phoneHref}`}>{contact.phone}</a></p>
        <Button href={url('/reservation/')}>Reserveer nu</Button>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const label = toggle?.querySelector('.visually-hidden');

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      if (label) label.textContent = open ? 'Menu sluiten' : 'Menu openen';
      document.documentElement.classList.toggle('menu-open', open);
      if (open) {
        menu.hidden = false;
        requestAnimationFrame(() => menu.classList.add('is-open'));
        menu.querySelector<HTMLAnchorElement>('a')?.focus();
      } else {
        menu.classList.remove('is-open');
        const done = () => { if (!menu.classList.contains('is-open')) menu.hidden = true; };
        menu.addEventListener('transitionend', done, { once: true });
        setTimeout(done, 600);
      }
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
  }
</script>

<style>
  .header {
    position: relative;
    z-index: 50;
  }
  .header__bar {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    min-height: var(--header-h);
    padding: 40px;
    border-bottom: 1px solid var(--c-line);
    background-color: var(--c-bg);
  }
  .header__left,
  .header__right {
    display: flex;
    align-items: center;
    min-width: 0;
  }
  .header__left { gap: 40px; }
  .header__right { justify-content: flex-end; gap: 16px; }

  .header__toggle {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin: -10px;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .header__burger {
    display: grid;
    gap: 6px;
    width: 24px;
  }
  .header__burger span {
    display: block;
    height: 1px;
    background: var(--c-pure-white);
    transition: transform 0.4s var(--ease), width 0.4s var(--ease);
  }
  .header__burger span:last-child { width: 16px; justify-self: end; }
  .header__toggle:hover .header__burger span:last-child { width: 24px; }
  :global(.menu-open) .header__burger span:first-child { transform: translateY(3.5px) rotate(45deg); }
  :global(.menu-open) .header__burger span:last-child { width: 24px; transform: translateY(-3.5px) rotate(-45deg); }

  .header__divider {
    width: 1px;
    height: 32px;
    background: var(--c-line-strong);
  }
  .header__nav ul {
    display: flex;
    gap: 40px;
    margin: 0;
  }
  .header__nav a {
    position: relative;
    font-family: var(--f-ui);
    font-size: 1rem;
    line-height: 1.2;
    letter-spacing: 0.045em;
    color: var(--c-pure-white);
    white-space: nowrap;
  }
  .header__nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 1px;
    background: var(--c-pink-bright);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.45s var(--ease);
  }
  .header__nav a:hover::after,
  .header__nav a[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .header__logo { color: var(--c-pure-white); }
  .header__logo :global(svg) { width: 107px; height: auto; }

  .header__rating {
    font-family: var(--f-ui);
    font-size: 0.875rem;
    line-height: 1.8;
    letter-spacing: 0.04em;
    color: var(--c-pure-white);
    white-space: nowrap;
  }

  /* Overlay menu */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 1;
    padding-top: var(--header-h);
    background: var(--c-bg-deep);
    overflow-y: auto;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s var(--ease), visibility 0.5s;
  }
  .menu.is-open { opacity: 1; visibility: visible; }
  :global(.menu-open) .header__bar { position: fixed; inset: 0 0 auto; }
  :global(.menu-open) body { overflow: hidden; }

  .menu__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 48px;
    align-items: end;
    padding-block: clamp(32px, 8vh, 96px);
  }
  .menu__list { display: grid; gap: 4px; margin: 0; }
  .menu__list li {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s var(--ease), transform 0.6s var(--ease);
    transition-delay: calc(var(--i) * 0.06s + 0.1s);
  }
  .menu.is-open .menu__list li { opacity: 1; transform: none; }
  .menu__list a {
    font-family: var(--f-display);
    font-size: clamp(2.5rem, 6vw, 5rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--c-pink);
    transition: color 0.3s, padding 0.4s var(--ease);
  }
  .menu__list a:hover,
  .menu__list a[aria-current='page'] { color: var(--c-pink-bright); padding-left: 12px; }
  .menu__meta {
    display: grid;
    gap: 24px;
    justify-items: start;
    font-family: var(--f-ui);
    font-size: 1rem;
    line-height: 1.8;
  }
  .menu__meta a:hover { color: var(--c-pink-bright); }

  @media (max-width: 1279px) {
    .header__rating { display: none; }
  }
  @media (max-width: 1023px) {
    .header__bar { padding: 20px var(--gutter); }
    .header__nav, .header__divider { display: none; }
    .header__logo :global(svg) { width: 84px; }
  }
  @media (max-width: 599px) {
    .header__bar { gap: 12px; }
    .header__right :global(.header__cta) { min-height: 44px; padding: 12px 18px; font-size: 0.875rem; }
    .header__right :global(.header__cta .btn__icon) { display: none; }
    .header__logo :global(svg) { width: 72px; }
    .menu__inner { grid-template-columns: 1fr; align-items: start; }
  }
</style>
