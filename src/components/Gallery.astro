---
// "Impressie": horizontally scrolling photo strip with prev/next buttons.
import { Image } from 'astro:assets';
import ButterflyTop from '../assets/icons/butterfly-top.svg';
import guests from '../assets/img/guests.jpg';
import party from '../assets/img/party.jpg';
import candle from '../assets/img/candle.jpg';
import flowers from '../assets/img/flowers.jpg';
import foodCandle from '../assets/img/food-candle.jpg';
import friends from '../assets/img/friends.jpg';
import { lorem } from '../data/site';

interface Props { ornament?: boolean }
const { ornament = true } = Astro.props;

const slides = [
  { src: guests, alt: 'Gasten in gesprek aan een lange gedekte tafel' },
  { src: party, alt: 'Feestelijk gezelschap aan tafel onder een slinger van hartjes' },
  { src: candle, alt: 'Roze kaars en bloemen op tafel tijdens een diner', tall: true },
  { src: flowers, alt: 'Boeket bloemen en ingepakte cadeaus bij kaarslicht' },
  { src: foodCandle, alt: 'Gedekte tafel met hapjes, soep en een gouden kandelaar' },
  { src: friends, alt: 'Twee vriendinnen omhelzen elkaar aan tafel' },
];
---

<section class="gallery" id="impressie" aria-labelledby="gallery-title">
  {ornament && (
    <div class="gallery__ornament" data-reveal="fade">
      <ButterflyTop width={64} height={33} aria-hidden="true" />
    </div>
  )}
  <div class="gallery__head text-center" data-reveal>
    <h2 id="gallery-title" class="h1">Impressie</h2>
    <p>{lorem}</p>
  </div>

  <div class="gallery__viewport" data-reveal="fade">
    <ul class="gallery__track" role="list" data-gallery-track tabindex="0" aria-label="Foto's van Nim">
      {slides.map((s) => (
        <li class:list={['gallery__slide', { 'gallery__slide--tall': s.tall }]}>
          <Image src={s.src} alt={s.alt} widths={[440, 880]} sizes="(max-width: 767px) 75vw, 478px" loading="lazy" />
        </li>
      ))}
    </ul>
  </div>

  <div class="gallery__controls">
    <button class="gallery__btn" type="button" data-gallery-prev aria-label="Vorige foto's">
      <svg width="32" height="32" viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M11.49 14.71h10.93v1.3H11.49l4.39 4.39-.92.92L9 15.36l5.96-5.96.92.92-4.39 4.39Z"/></svg>
    </button>
    <button class="gallery__btn" type="button" data-gallery-next aria-label="Volgende foto's">
      <svg width="32" height="32" viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M19.93 16.01H9v-1.3h10.93l-4.39-4.39.92-.92 5.96 5.96-5.96 5.96-.92-.92 4.39-4.39Z"/></svg>
    </button>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.gallery').forEach((gallery) => {
    const track = gallery.querySelector<HTMLElement>('[data-gallery-track]');
    const prev = gallery.querySelector<HTMLButtonElement>('[data-gallery-prev]');
    const next = gallery.querySelector<HTMLButtonElement>('[data-gallery-next]');
    if (!track || !prev || !next) return;

    const step = () => {
      const slide = track.querySelector<HTMLElement>('.gallery__slide');
      return slide ? slide.offsetWidth + 24 : track.clientWidth * 0.8;
    };
    const update = () => {
      const max = track.scrollWidth - track.clientWidth - 2;
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max;
    };

    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    // Open centred on the tall feature photo, as in the Figma frame.
    const feature = track.querySelector<HTMLElement>('.gallery__slide--tall');
    if (feature) track.scrollLeft = feature.offsetLeft - (track.clientWidth - feature.offsetWidth) / 2;

    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
</script>

<style>
  .gallery { padding-top: var(--section-y); overflow: hidden; }
  .gallery__ornament {
    position: relative;
    display: flex;
    justify-content: center;
    max-width: var(--w-wide);
    margin: 0 auto 64px;
    padding-inline: var(--gutter);
  }
  .gallery__ornament::before {
    content: '';
    position: absolute;
    inset-inline: var(--gutter);
    top: 50%;
    height: 1px;
    background: var(--c-line-strong);
  }
  .gallery__ornament :global(svg) {
    position: relative;
    box-sizing: content-box;
    padding-inline: 18px;
    background: var(--c-bg);
  }

  .gallery__head {
    display: grid;
    gap: 48px;
    max-width: calc(872px + var(--gutter) * 2);
    margin: 0 auto 64px;
    padding-inline: var(--gutter);
  }
  .gallery__head p { padding-inline: clamp(0px, 8vw, 112px); }

  .gallery__track {
    position: relative;
    display: flex;
    align-items: center;
    gap: 24px;
    margin: 0;
    padding: 0 max(var(--gutter), calc((100vw - var(--w-wide)) / 2));
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .gallery__track::-webkit-scrollbar { display: none; }

  .gallery__slide {
    flex: 0 0 clamp(240px, 30.3vw, 437px);
    aspect-ratio: 437 / 600;
    overflow: hidden;
    scroll-snap-align: center;
  }
  .gallery__slide--tall {
    flex-basis: clamp(262px, 33.2vw, 478px);
    aspect-ratio: 478 / 656;
  }
  .gallery__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 1.1s var(--ease);
  }
  .gallery__slide:hover img { scale: 1.05; }

  .gallery__controls {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 48px;
  }
  .gallery__btn {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 1.5px solid var(--c-pink-bright);
    border-radius: 50px;
    background: transparent;
    color: var(--c-pink-bright);
    cursor: pointer;
    transition: background-color 0.3s, color 0.3s, opacity 0.3s;
  }
  .gallery__btn:hover:not(:disabled) { background: var(--c-pink-bright); color: var(--c-bg); }
  .gallery__btn:disabled { border-color: rgba(229, 164, 155, 0.6); opacity: 0.6; cursor: default; }

  @media (max-width: 767px) {
    .gallery__slide { flex-basis: 72vw; }
    .gallery__slide--tall { flex-basis: 78vw; }
    .gallery__track { gap: 16px; }
  }
</style>
