---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import MediaText from '../components/MediaText.astro';
import Benefits from '../components/Benefits.astro';
import Gallery from '../components/Gallery.astro';
import CtaBig from '../components/CtaBig.astro';
import MenuTable from '../components/MenuTable.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import roomTable from '../assets/img/room-table.jpg';
import wine from '../assets/img/wine.jpg';
import painting from '../assets/img/painting.jpg';
import { lorem } from '../data/site';
---

<BaseLayout
  title="Private dining op de Amsterdamse grachten | Nim"
  description="Private dining in een karakteristieke privéruimte aan de Keizersgracht. Lunch- en dinermenu's op maat voor uw gezelschap, met persoonlijke service."
>
  <section class="split-hero">
    <div class="split-hero__text">
      <h1 class="h2 hero-in">Private dining op de Amsterdamse grachten</h1>
      <p class="hero-in" style="--hero-delay:.15s">{lorem}</p>
      <div class="btn-row hero-in" style="--hero-delay:.3s">
        <Button href="/reservation/">Reserveer nu</Button>
        <Button href="/reservation/?type=offerte" variant="outline">Offerte opvragen</Button>
      </div>
    </div>
    <div class="split-hero__media hero-in" style="--hero-delay:.1s">
      <Image
        src={roomTable}
        alt="Lange gedekte tafel in de privéruimte aan de gracht"
        widths={[600, 1024]}
        sizes="(max-width: 899px) 100vw, 692px"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </section>
  <hr class="rule" />

  <MediaText title="Introtekst dienst" text={lorem} image={wine} alt="Wijnkoeler met flessen aan een feestelijke tafel" ornament />
  <Benefits />
  <Gallery />
  <CtaBig />
  <MediaText title="Extra informatie indien nodig" text={lorem} image={painting} alt="Schilderij in gouden lijst aan de donkere muur" reverse />
  <section class="menu-section container" aria-label="Menu's en prijzen">
    <MenuTable />
  </section>
  <Testimonials />
  <Faq />
  <CtaBig />
</BaseLayout>

<style>
  .split-hero {
    display: grid;
    grid-template-columns: minmax(0, 621fr) minmax(0, 692fr);
    align-items: start;
    gap: 47px;
    max-width: calc(var(--w-wide) + var(--gutter) * 2);
    margin-inline: auto;
    padding: clamp(40px, 4.8vw, 69px) var(--gutter) 65px;
  }
  .split-hero__text {
    display: grid;
    justify-items: start;
    gap: 40px;
    padding-top: 85px;
  }
  .split-hero__text p { max-width: 443px; letter-spacing: 0; }
  .split-hero__text .btn-row { margin-top: 0; }
  .split-hero__media { aspect-ratio: 692 / 667; overflow: hidden; }
  .split-hero__media img { width: 100%; height: 100%; object-fit: cover; }

  .rule {
    max-width: calc(var(--w-wide) - 1px);
    margin: 0 auto;
    border: 0;
    border-top: 1px solid var(--c-line-strong);
  }
  .menu-section { padding-block: var(--section-y) 0; }

  @media (max-width: 899px) {
    .split-hero { grid-template-columns: 1fr; gap: 40px; }
    .split-hero__text { padding-top: 0; gap: 28px; }
    .split-hero__media { aspect-ratio: 4 / 3; }
    .rule { margin-inline: var(--gutter); }
  }
</style>
