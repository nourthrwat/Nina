---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaText from '../components/MediaText.astro';
import Faq from '../components/Faq.astro';
import ContactBlock from '../components/ContactBlock.astro';
import team from '../assets/img/team.jpg';
import painting from '../assets/img/painting.jpg';

const copy =
  'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Praesent eget sapien sit amet magna sollicitudin semper. Integer fringilla placerat. Lorem ipsum dolor sit amet, consectetur adipiscing elit. Praesent eget sapien sit amet magna sollicitudin semper. Integer fringilla placerat.';
---

<BaseLayout
  title="Bedankt voor uw reservering | Nim Amsterdam"
  description="Bedankt voor uw reservering bij Nim. Ons team neemt zo snel mogelijk contact met u op om alles voor te bereiden."
>
  <section class="thanks">
    <h1 class="h1 thanks__title hero-in">Bedankt voor uw reservering, ons team staat voor u klaar.</h1>
    <div class="thanks__media hero-in" style="--hero-delay:.15s">
      <Image src={team} alt="Het team van Nim in koksbuizen en zwarte outfits" widths={[600]} sizes="(max-width: 899px) 100vw, 879px" loading="eager" />
    </div>
  </section>
  <MediaText title="Extra informatie indien nodig" text={copy} image={painting} alt="Schilderij in gouden lijst aan de donkere muur" reverse />
  <Faq />
  <ContactBlock />
</BaseLayout>

<style>
  .thanks {
    display: grid;
    grid-template-columns: minmax(0, 420fr) minmax(0, 879fr);
    max-width: calc(var(--w-wide) + var(--gutter) * 2);
    margin-inline: auto;
    padding: clamp(48px, 6.9vw, 100px) 0 128px var(--gutter);
  }
  .thanks__title {
    position: relative;
    z-index: 1;
    grid-column: 1 / -1;
    grid-row: 1;
    max-width: 635px;
    margin-left: clamp(0px, 6.9vw, 99px);
  }
  .thanks__media {
    position: relative;
    grid-column: 2;
    grid-row: 1;
    margin-top: 143px;
    aspect-ratio: 879 / 600;
    overflow: hidden;
  }
  .thanks__media::after { content: ''; position: absolute; inset: 0; background: rgba(0, 0, 0, 0.4); }
  .thanks__media img { width: 100%; height: 100%; object-fit: cover; }

  @media (max-width: 899px) {
    .thanks { grid-template-columns: 1fr; padding: 48px var(--gutter) 64px; }
    .thanks__title { margin-left: 0; }
    .thanks__media { grid-column: 1; grid-row: 2; margin-top: 40px; aspect-ratio: 3 / 2; }
  }
</style>
